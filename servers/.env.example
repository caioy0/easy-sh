# ============================================================================
# servers/.env  — shared fleet configuration
#
# Copies this file to `.env` and edit the values you need (passwords, timezone,
# Cloudflare Tunnel domain). Everything already has a safe default, so you only
# MUST fill in the items marked REQUIRED.
#
#   cp servers/.env.example servers/.env && $EDITOR servers/.env
#
# JVM RAM budget (.clinerules): NEVER exceed 3 GB across all Java services.
#   Minecraft is capped by MC_MAX_MEMORY (default 2G).
#   Terraria is a native binary (no JVM) and is lightweight (~600 MB) on its own.
# ============================================================================

# ------------------------------------------------------------------ timezone
TZ=UTC

# ----------------------------------------------------------------- minecraft
# PaperMC JVM heap. MEMORY sets both initial (Xms) and max (Xmx).
# Keep <= 2G so the total JVM footprint stays under the 3 GB limit.
MC_MEMORY=2G
# Optional finer control (leave empty to use MC_MEMORY for both):
MC_INIT_MEMORY=
MC_MAX_MEMORY=

# Container runs as a non-root user. Usually your desktop/ssh UID/GID (1000).
MC_UID=1000
MC_GID=1000

# RCON management password (REQUIRED — change from the default!)
MC_RCON_PASSWORD=your_rcon_password_here

# Server limits
MC_MAX_PLAYERS=8
MC_DIFFICULTY=normal

# Optional: auto-pause the JVM after idle so a headless box costs nothing when
# nobody is playing. Set to "true" to enable.
MC_AUTOPAUSE=false

# ------------------------------------------------------------------- terraria
# Server name / world file (no spaces unless you URL-encode them).
TERRARIA_WORLDNAME=eterrain
# Size used when the world is auto-created: 1=small 2=medium 3=large
TERRARIA_AUTOCREATE=2
# 0=normal 1=expert 2=master 3=journey
TERRARIA_DIFFICULTY=0
TERRARIA_MAXPLAYERS=8
# Server join password (leave empty for none; REQUIRED if you want access control)
TERRARIA_PASSWORD=
TERRARIA_MOTD=Welcome to eterrain!
# 1 = prevent cheats (recommended), 0 = allow
TERRARIA_SECURE=1

# ---------------------------------------------------------------- cloudflared
# Cloudflare Tunnel — secure HTTPS access to local web dashboards (e.g. Dockge
# on :5001) via a custom domain. Provisioned by cloudflared/setup.sh.
#
# Public hostname that Cloudflare will route to the local service.
CF_DOMAIN=
# Local service the tunnel proxies to (Dockge on :5001 by default). If a target
# runs in another container/network, set this to its reachable URL/IP instead.
CF_LOCAL_SERVICE=http://localhost:5001
# Named tunnel used for the Cloudflare Tunnel ("minipc-tunnel").
CF_TUNNEL_NAME=minipc-tunnel
# Run mode: "docker" (default) or "systemd" (native service)
CF_RUN_MODE=docker